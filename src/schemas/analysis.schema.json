{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypotheses", "timeline"],
  "properties": {
    "hypotheses": {
      "type": "array",
      "items": { "$ref": "hypothesis.schema.json" }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts", "summary", "evidence_ids"],
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
          },
          "summary": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
