{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ts", "source", "service", "severity", "ref", "text"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "source": { "type": "string", "enum": ["log", "alert", "commit", "deploy", "flag"] },
    "service": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["debug", "info", "warn", "error", "critical"] },
    "signature": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "text": { "type": "string" }
  }
}
