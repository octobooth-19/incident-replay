{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summary", "confidence", "evidence_ids", "unverified_assumptions", "suspect_files"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unverified_assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "suspect_files": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
